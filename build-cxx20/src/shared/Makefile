	cd /home/wowvmangos/vmangos/build-cxx20 && $(MAKE) $(MAKESILENT) -f src/shared/CMakeFiles/shared.dir/build.make src/shared/CMakeFiles/shared.dir/TimePeriod.cpp.i
.PHONY : TimePeriod.cpp.i

TimePeriod.s: TimePeriod.cpp.s
.PHONY : TimePeriod.s

